<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>Library</OutputType>
    <AssemblyName>ParatextNoteSuggestions</AssemblyName>
    <RootNamespace>ParatextNoteSuggestions</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>5</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <OutputPath>..\artifacts\ide\</OutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Optimize>true</Optimize>
    <ParatextDir Condition="'$(ParatextDir)' == ''">$(ProgramW6432)\Paratext 9</ParatextDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="netstandard" />
    <Reference Include="CorePluginInterfaces"><HintPath>$(ParatextDir)\CorePluginInterfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PluginInterfaces"><HintPath>$(ParatextDir)\PluginInterfaces.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="EmbeddedUiPluginInterfaces"><HintPath>$(ParatextDir)\EmbeddedUiPluginInterfaces.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="Domain.cs" />
    <Compile Include="NoteService.cs" />
    <Compile Include="QueueTargetHighlight.cs" />
    <Compile Include="Plugin.cs" />
    <Compile Include="ReviewForm.cs" />
    <Compile Include="ReviewProgress.cs" />
    <Compile Include="QueueForm.cs" />
    <Compile Include="QueueControl.cs" />
    <Compile Include="ParatextTheme.cs" />
    <Compile Include="..\artifacts\obj\VersionInfo.cs" />
    <Compile Include="QueueScope.cs" />
    <Compile Include="BulkResolveDialog.cs" />
    <Compile Include="ReviewReports.cs" />
    <Compile Include="FastReview.cs" />
    <Compile Include="FootnoteComposer.cs" />
    <Compile Include="WordingSheet.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- The version comes from VERSION and the commit history; see scripts/version.ps1. -->
  <Target Name="VersionInfo" BeforeTargets="CoreCompile"><Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\build.ps1&quot; -VersionInfoOnly" /></Target>
  <Target Name="PluginExtension" AfterTargets="Build"><Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(TargetName).ptxplg" /></Target>
</Project>
